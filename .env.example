# DEV-ONLY placeholders for `docker compose` (SC-32). Copy to .env, which is git-ignored.
# Never reuse any value below in a real environment.
POSTGRES_PASSWORD=orderrouter-dev-only
POSTGRES_PORT=5432
API_PORT=8080
# Placeholder development API key (dev-only), sent as `X-Api-Key`. It only works in the Development environment (OR-008).
DEV_API_KEY=dev-only-change-me
# Placeholder secret for the caller hash (HMAC-SHA256 of the caller ID, OR-027). Dev-only; the API refuses to start without a value.
# For local `dotnet run`, use user-secrets instead: dotnet user-secrets set "CallerHashing:Secret" "<value>" --project src/OrderRouter.Api
CALLER_HASHING_SECRET=caller-hash-dev-only-change-me
