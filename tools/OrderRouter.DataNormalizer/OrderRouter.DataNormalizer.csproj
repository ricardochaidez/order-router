<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline console tool (OR-003). It sits outside the four layers, references only Domain, and is
       never referenced by anything under src/, so it does not ship with the API. TargetFramework,
       Nullable and ImplicitUsings come from Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- CsvHelper (ADR-0002): reads and writes the CSV files, including quoted cells and CRLF.
         Pinned to 33.x on purpose: 34.0 is a rewrite with a different, byte/stream-based API. -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <!-- Console logging for the data-quality report (NFR-04); used by this tool only. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OrderRouter.Domain\OrderRouter.Domain.csproj" />
  </ItemGroup>

</Project>
