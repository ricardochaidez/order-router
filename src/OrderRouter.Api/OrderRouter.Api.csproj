<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>OrderRouter.Api</RootNamespace>
    <!-- Holds Authentication:DevApiKey locally (dotnet user-secrets), never appsettings files (SC-32). -->
    <UserSecretsId>order-router-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Design-time only: `dotnet ef ... -s OrderRouter.Api -p OrderRouter.Infrastructure` runs from this startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Reloadable experiment settings (OR-016). Copied next to the app so a deployment can edit or mount it. -->
    <Content Update="experiments.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The health types are internal on purpose; the unit tests exercise them directly without a host. -->
    <InternalsVisibleTo Include="OrderRouter.Tests" />
    <InternalsVisibleTo Include="OrderRouter.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrderRouter.Domain\OrderRouter.Domain.csproj" />
    <ProjectReference Include="..\OrderRouter.Infrastructure\OrderRouter.Infrastructure.csproj" />
  </ItemGroup>

</Project>
